# ChakraOS backend (Supabase remains the data/Edge Functions backend)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Firebase Authentication (email/password)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat / App Store + Play billing
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# EAS project link (from `npx eas init` / expo.dev)
EAS_PROJECT_ID=
EXPO_OWNER=
EXPO_TOKEN=

# Optional native ID overrides
CHAKRAOS_APP_VERSION=1.0.0
CHAKRAOS_IOS_BUNDLE_ID=com.chakraos.app
CHAKRAOS_ANDROID_PACKAGE=com.chakraos.app

# Required for non-interactive iOS EAS Submit (App Store Connect → App Information → Apple ID)
CHAKRAOS_APP_STORE_APP_ID=
# Optional Apple team / account overrides
CHAKRAOS_APPLE_TEAM_ID=
EXPO_APPLE_ID=
# Prefer App Store Connect API key via `eas credentials` over app-specific password
# EXPO_APPLE_APP_SPECIFIC_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set via `supabase secrets set`, not Expo)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
