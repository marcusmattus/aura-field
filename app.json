{
  "expo": {
    "name": "ChakraOS",
    "slug": "chakraos",
    "owner": "chakraos",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "chakraos",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.chakraos.app"
    },
    "android": {
      "package": "com.chakraos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b41c9366-6ac4-4320-aa9f-a2e1f3aaca3a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b41c9366-6ac4-4320-aa9f-a2e1f3aaca3a",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#05060A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#05060A"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ChakraOS to record voice journal entries on this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ChakraOS to use the camera so Palm Field and Mudra practice can show your hand on screen.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
